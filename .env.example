# GitHub OAuth - Create an OAuth app at https://github.com/settings/developers
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# NextAuth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here

# NextAuth URL (set to your app's URL)
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL - Automatically set by Aspire when running via `aspire start`
# GARDENDB_URI=postgresql://postgres:postgres@localhost:5432/gardendb
