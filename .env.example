# ─── Aspire Parameters ───────────────────────────────────────────────────────
# When running via `aspire start`, secrets are managed as Aspire parameters.
# Configure them in the Aspire dashboard, or set them in appsettings.json:
#
#   {
#     "Parameters": {
#       "github-id": "your_github_client_id",
#       "github-secret": "your_github_client_secret"
#     }
#   }
#
# AUTH_SECRET is auto-generated and persisted by Aspire (no manual config needed).
#
# ─── Manual (non-Aspire) Configuration ───────────────────────────────────────
# If running without Aspire, set these environment variables:

# GitHub OAuth - Create an OAuth app at https://github.com/settings/developers
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# NextAuth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here

# NextAuth URL (set to your app's URL)
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL - Automatically set by Aspire when running via `aspire start`
# GARDENDB_URI=postgresql://postgres:postgres@localhost:5432/gardendb
